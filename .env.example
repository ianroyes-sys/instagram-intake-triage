# Folder the fetcher writes batches and slide images into (default <repo>/data/intake).
INTAKE_DIR=
# Next.js host only: project root that holds data/intake and scripts/ (default process.cwd()).
INTAKE_ROOT=
# Next.js host only: shell command that runs one triage pass, e.g. claude -p "$(cat loops/intake-triage.md)"
INTAKE_TRIAGE_COMMAND=
# Optional second skills root to list in the Arsenal view (a folder that contains .claude/skills).
VAULT_PATH=
# Optional: your eligibility profile the triage agent checks opportunities against.
OPPORTUNITY_PROFILE=
